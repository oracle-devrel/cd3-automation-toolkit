nlb_reserved_private_ips = {
    ##Add New Network Load Balancer Reserved Private IPs for {{ region|lower }} here##
}{% else %} {% if reserved_ips_id|lower == 'y' and is_private|lower in ['y', 'yes', 'true'] %}

    {{ nlb_tf_name }}-reserved-ip = {
            network_compartment_id = "{{ network_compartment_tf_name }}"
            vcn_name               = "{{ vcn_name }}"
            subnet_id              = "{{ subnet_id }}"
            lifetime               = "RESERVED"
            display_name           = "{{ nlb_tf_name }}-reserved-ip"

            {% if reserved_private_ip and reserved_private_ip != "" and reserved_private_ip != "nan" %}
            ip_address             = "{{ reserved_private_ip }}"
            {% endif %}

            {% if hostname_label and hostname_label != "" and hostname_label != "nan" %}
            hostname_label         = "{{ hostname_label }}"
            {% endif %}

            {% if vlan_id and vlan_id != "" and vlan_id != "nan" %}
            vlan_id                = "{{ vlan_id }}"
            {% endif %}

            {% if vnic_id and vnic_id != "" and vnic_id != "nan" %}
            vnic_id                = "{{ vnic_id }}"
            {% endif %}

        {#  ##Do not modify below this line##  #}
        {#                                     #}
        {#  ###Section for adding Defined and Freeform Tags###  #}
        {% if defined_tags and defined_tags != 'nan' and defined_tags != '' and defined_tags != [['nan']] %}
          {% if defined_tags[0] %}
            defined_tags = {
            {% for tags in defined_tags  %}
                {% if not loop.last %}
                    "{{ tags[0]  }}"= "{{ tags[1] }}" ,
                {% else %}
                    "{{ tags[0]  }}"= "{{ tags[1] }}"
                {% endif %}
            {% endfor %}
            }
            {% endif %}
        {% endif %}

        {% if freeform_tags and freeform_tags != 'nan' and freeform_tags != '' and freeform_tags != [['nan']] %}
          {% if freeform_tags[0] %}
            freeform_tags = {
            {% for tags in freeform_tags %}
                {% if not loop.last  %}
                    "{{ tags[0] }}"="{{ tags[1] }}",
                {% else %}
                    "{{ tags[0] }}"="{{ tags[1] }}"
                {% endif %}
            {% endfor %}
            }
          {% endif %}
        {% endif %}
        {#  ###Section for adding Defined and Freeform Tags ends here###  #}
    },
{% endif %}
{% endif %}